+import { expect, test } from "bun:test"
+import { LocalContext } from "../../src/session/local-context"
+
+test("local project context is opt-in without changing other providers", () => {
+  const original = process.env.LOCALCODE_CONTEXT
+  try {
+    delete process.env.LOCALCODE_CONTEXT
+    expect(LocalContext.fullContext("localcode")).toBe(false)
+    expect(LocalContext.fullContext("other")).toBe(true)
+    process.env.LOCALCODE_CONTEXT = "full"
+    expect(LocalContext.fullContext("localcode")).toBe(true)
+  } finally {
+    if (original === undefined) delete process.env.LOCALCODE_CONTEXT
+    else process.env.LOCALCODE_CONTEXT = original
+  }
+})
+
+test("compact schemas preserve property names, validation and descriptions", () => {
+  const schema = {
+    type: "object", title: "Verbose generated title", required: ["title"],
+    properties: {
+      title: { type: "string", minLength: 1, description: "Page title" },
+      description: { type: "string", description: "d".repeat(800), examples: ["big example"] },
+      default: { type: "number", minimum: 0 },
+    },
+    additionalProperties: false,
+  }
+  const original = JSON.stringify(schema)
+  const compact = LocalContext.compactToolSchema(schema)
+  expect(compact.title).toBeUndefined()
+  expect(compact.required).toEqual(["title"])
+  expect(compact.properties.title).toEqual(schema.properties.title)
+  expect(compact.properties.default.minimum).toBe(0)
+  expect(compact.properties.description.description.length).toBeLessThanOrEqual(160)
+  expect(compact.additionalProperties).toBe(false)
+  expect(JSON.stringify(schema)).toBe(original)
+})
+
+test("minimal startup connects only explicitly enabled MCPs, while toggles and other hosts work", () => {
+  expect(LocalContext.mcpStartupEnabled(undefined, "minimal")).toBe(false)
+  expect(LocalContext.mcpStartupEnabled(false, "minimal")).toBe(false)
+  expect(LocalContext.mcpStartupEnabled(true, "minimal")).toBe(true)
+  expect(LocalContext.mcpStartupEnabled(undefined, "full")).toBe(true)
+  expect(LocalContext.mcpStartupEnabled(false, "full")).toBe(false)
+  expect(LocalContext.mcpStartupEnabled(undefined, "other-host")).toBe(true)
+})
