+/** Keep local startup small; full project context is an explicit launch choice. */
+export function fullContext(providerID: string) {
+  return providerID !== "localcode" || process.env.LOCALCODE_CONTEXT === "full"
+}
+
+export function mcpStartupEnabled(enabled?: boolean, mode = process.env.LOCALCODE_CONTEXT) {
+  return enabled !== false && (mode !== "minimal" || enabled === true)
+}
+
+/** Remove schema documentation noise without changing fields or constraints. */
+export function compactToolSchema<T>(value: T): T {
+  return compact(value) as T
+}
+
+function compact(value: unknown): unknown {
+  if (typeof value !== "object" || value === null) return value
+  if (Array.isArray(value)) return value.map(compact)
+  const result: Record<string, unknown> = {}
+  for (const [key, item] of Object.entries(value)) {
+    if (["$schema", "title", "examples", "default"].includes(key)) continue
+    if (["properties", "$defs", "definitions", "patternProperties", "dependentSchemas"].includes(key)) {
+      result[key] = typeof item === "object" && item !== null ? Object.fromEntries(Object.entries(item).map(([name, schema]) => [name, compact(schema)])) : item
+    } else if (["items", "additionalProperties", "anyOf", "oneOf", "allOf", "not", "if", "then", "else", "prefixItems", "contains"].includes(key)) {
+      result[key] = compact(item)
+    } else if (key === "description" && typeof item === "string" && item.length > 160) {
+      result[key] = item.slice(0, 157) + "…"
+    } else {
+      result[key] = item
+    }
+  }
+  return result
+}
+
+export * as LocalContext from "./local-context"
