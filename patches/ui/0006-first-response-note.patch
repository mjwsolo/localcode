diff --git a/packages/tui/src/ui/first-response-note.ts b/packages/tui/src/ui/first-response-note.ts
new file mode 100644
--- /dev/null
+++ b/packages/tui/src/ui/first-response-note.ts
@@ -0,0 +1,16 @@
+export interface ModelProgress {
+  phase?: string
+  warmup?: boolean
+  context_ready?: boolean
+  request_id?: string
+  done?: number
+  todo?: number
+  decoded?: number
+}
+
+export function firstResponseNote(progress: ModelProgress): string {
+  if (progress.phase !== "reading") return ""
+  // Do not explain cached turns, background compaction or an unknown readiness state.
+  if (!progress.warmup && (progress.context_ready !== false || !progress.request_id?.startsWith("0:") || (progress.todo ?? 0) < 512)) return ""
+  return "Preparing this model’s instructions and tools on your Mac.\nThe first response may take longer; follow-up messages usually start faster."
+}
diff --git a/packages/tui/test/ui/first-response-note.test.ts b/packages/tui/test/ui/first-response-note.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/tui/test/ui/first-response-note.test.ts
@@ -0,0 +1,17 @@
+import { expect, test } from "bun:test"
+import { firstResponseNote } from "../../src/ui/first-response-note"
+
+test("explains real cold prefill and warm-up, never cached or later turns", () => {
+  const cold = { phase: "reading", request_id: "0:2", todo: 4000, context_ready: false }
+  expect(firstResponseNote(cold)).toContain("instructions and tools")
+  expect(firstResponseNote({ ...cold, warmup: true })).toContain("usually start faster")
+  expect(firstResponseNote({ ...cold, context_ready: true })).toBe("")
+  expect(firstResponseNote({ ...cold, todo: 3 })).toBe("")
+  expect(firstResponseNote({ ...cold, request_id: "3:4" })).toBe("")
+  expect(firstResponseNote({ ...cold, context_ready: undefined })).toBe("")
+  expect(firstResponseNote({ ...cold, phase: "generating" })).toBe("")
+  expect(firstResponseNote({ phase: "unknown" })).toBe("")
+  expect(firstResponseNote({ phase: "idle" })).toBe("")
+  // A switch to another cold server can show the explanation again.
+  expect(firstResponseNote({ ...cold, request_id: "0:1" })).not.toBe("")
+})
