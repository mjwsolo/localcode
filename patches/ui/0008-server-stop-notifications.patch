+/** @jsxImportSource @opentui/solid */
+import { createDefaultOpenTuiKeymap } from "@opentui/keymap/opentui"
+import { testRender, useRenderer } from "@opentui/solid"
+import { expect, test } from "bun:test"
+import { mkdir } from "node:fs/promises"
+import path from "node:path"
+import { onCleanup, onMount } from "solid-js"
+import { tmpdir } from "../../fixture/fixture"
+import { createTuiResolvedConfig } from "../../fixture/tui-runtime"
+import { TestTuiContexts } from "../../fixture/tui-environment"
+
+test.each(["notice", "escape", "cancel"] as const)("dialog notification and cancellation: %s", async (mode) => {
+  await using tmp = await tmpdir()
+  const state = path.join(tmp.path, "state")
+  await mkdir(state, { recursive: true })
+  await Bun.write(path.join(state, "kv.json"), "{}")
+  const [dialog, toast, kv, theme, config, keymap, confirmation] = await Promise.all([
+    import("../../../src/ui/dialog"), import("../../../src/ui/toast"),
+    import("../../../src/context/kv"), import("../../../src/context/theme"),
+    import("../../../src/config"), import("../../../src/keymap"), import("../../../src/ui/dialog-confirm"),
+  ])
+  let confirmed = 0
+  let cancelled = 0
+  let modal: ReturnType<typeof dialog.useDialog> | undefined
+  function Page() {
+    modal = dialog.useDialog()
+    const notice = toast.useToast()
+    onMount(() => {
+      if (mode === "notice") {
+        modal!.replace(() => <text>Model server options</text>)
+        notice.show({ title: "Server operation failed", message: "The server did not stop", variant: "error", duration: 60000 })
+      } else {
+        modal!.replace(() => <confirmation.DialogConfirm title="Stop shared model server?" message="Interrupt active requests?"
+          onConfirm={() => { confirmed++ }} onCancel={() => { cancelled++ }} />)
+      }
+    })
+    return <text>Chat history</text>
+  }
+  function Harness() {
+    const renderer = useRenderer()
+    const bindings = createDefaultOpenTuiKeymap(renderer)
+    const resolved = createTuiResolvedConfig({ keybinds: {}, leader_timeout: 1000 })
+    const off = keymap.registerOpencodeKeymap(bindings, renderer, resolved)
+    onCleanup(off)
+    return (
+      <TestTuiContexts directory={tmp.path} paths={{ home: tmp.path, state, worktree: tmp.path }}>
+        <keymap.OpencodeKeymapProvider keymap={bindings}>
+          <config.TuiConfigProvider config={resolved}>
+            <kv.KVProvider>
+              <theme.ThemeProvider mode="dark">
+                <toast.ToastProvider>
+                  <dialog.DialogProvider><Page /></dialog.DialogProvider>
+                </toast.ToastProvider>
+              </theme.ThemeProvider>
+            </kv.KVProvider>
+          </config.TuiConfigProvider>
+        </keymap.OpencodeKeymapProvider>
+      </TestTuiContexts>
+    )
+  }
+  const app = await testRender(() => <Harness />, { width: 100, height: 30 })
+  try {
+    for (let i = 0; i < 100 && (mode === "notice" ? !app.renderer.root.findDescendantById("notification-toast") : !app.captureCharFrame().includes("Stop shared model server?")); i++) {
+      await Bun.sleep(10)
+      await app.renderOnce()
+    }
+    if (mode !== "notice") {
+      expect(modal!.stack.length).toBe(1)
+      if (mode === "escape") app.mockInput.pressEscape()
+      else { app.mockInput.pressArrow("left"); app.mockInput.pressEnter() }
+      await Bun.sleep(20)
+      await app.renderOnce()
+      expect(modal!.stack.length).toBe(0)
+      expect(confirmed).toBe(0)
+      expect(cancelled).toBe(mode === "cancel" ? 1 : 0)
+      return
+    }
+    const notification = app.renderer.root.findDescendantById("notification-toast")
+    expect(notification).toBeDefined()
+    expect(notification!.parent).toBe(app.renderer.root)
+    const overlays = app.renderer.root.getChildren().filter(child => child.zIndex === 3000)
+    expect(overlays.length).toBeGreaterThan(0)
+    expect(notification!.zIndex).toBeGreaterThan(Math.max(...overlays.map(child => child.zIndex)))
+    expect(app.captureCharFrame()).toContain("The server did not stop")
+  } finally {
+    app.renderer.destroy()
+  }
+})
