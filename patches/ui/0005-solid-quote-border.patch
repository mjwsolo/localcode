@@ -0,0 +1,7 @@
+import { RGBA } from "@opentui/core"
+
+export const SENT_MESSAGE_BACKGROUND = RGBA.fromHex("#3d3e3f")
+
+export function messagePanelStyle(background: RGBA) {
+  return { border: false, paddingLeft: 1, backgroundColor: background } as const
+}
diff --git a/packages/tui/src/ui/solid-quote.ts b/packages/tui/src/ui/solid-quote.ts
new file mode 100644
index 0000000000..b555cf13b5
--- /dev/null
+++ b/packages/tui/src/ui/solid-quote.ts
@@ -0,0 +1,14 @@
+import { BoxRenderable, type Renderable } from "@opentui/core"
+import { SplitBorder } from "./border"
+
+export function solidQuoteBorder(node: Renderable | null) {
+  if (!(node instanceof BoxRenderable)) return node
+  node.customBorderChars = { ...SplitBorder.customBorderChars, vertical: " " }
+  const after = node.renderAfter
+  node.renderAfter = function (buffer, deltaTime) {
+    after?.call(this, buffer, deltaTime)
+    // Paint cells rather than glyphs: font leading and blank rows stay filled.
+    buffer.fillRect(node.x, node.y, 1, node.height, node.borderColor)
+  }
+  return node
+}
diff --git a/packages/tui/test/ui/message-panel.test.ts b/packages/tui/test/ui/message-panel.test.ts
new file mode 100644
index 0000000000..43701aa860
--- /dev/null
+++ b/packages/tui/test/ui/message-panel.test.ts
@@ -0,0 +1,26 @@
+import { expect, test } from "bun:test"
+import { BoxRenderable, RGBA, TextRenderable } from "@opentui/core"
+import { createTestRenderer } from "@opentui/core/testing"
+import { messagePanelStyle, SENT_MESSAGE_BACKGROUND } from "../../src/ui/message-panel"
+
+for (const [name, background] of [["sent", SENT_MESSAGE_BACKGROUND], ["input", RGBA.fromHex("#171717")]] as const) {
+  test(`${name} panel has a uniform background without an accent stripe`, async () => {
+    const setup = await createTestRenderer({ width: 24, height: 8, useThread: false })
+    const panel = new BoxRenderable(setup.renderer, { width: "100%", ...messagePanelStyle(background) })
+    const body = new BoxRenderable(setup.renderer, { paddingLeft: 2, paddingTop: 1, paddingBottom: 1, backgroundColor: background })
+    body.add(new TextRenderable(setup.renderer, { content: "Message", fg: "#ffffff" }))
+    panel.add(body)
+    try {
+      setup.renderer.root.add(panel)
+      await setup.flush()
+      const frame = setup.captureSpans()
+      for (const line of frame.lines.slice(0, panel.height)) {
+        expect(line.spans[0].bg.toInts()).toEqual(background.toInts())
+      }
+      expect(setup.captureCharFrame().split("\n")[1].indexOf("Message")).toBe(3)
+      if (name === "sent") expect(frame.lines[0].spans[0].bg.toInts()).toEqual([61, 62, 63, 255])
+    } finally {
+      setup.renderer.destroy()
+    }
+  })
+}
diff --git a/packages/tui/test/ui/solid-quote.test.ts b/packages/tui/test/ui/solid-quote.test.ts
new file mode 100644
index 0000000000..5fdea37f47
--- /dev/null
+++ b/packages/tui/test/ui/solid-quote.test.ts
@@ -0,0 +1,50 @@
+import { expect, test } from "bun:test"
+import { MarkdownRenderable, RGBA, SyntaxStyle } from "@opentui/core"
+import { createTestRenderer, MockTreeSitterClient } from "@opentui/core/testing"
+import { solidQuoteBorder } from "../../src/ui/solid-quote"
+
+for (const streaming of [false, true]) test(`quote background stays continuous (streaming=${streaming})`, async () => {
+  const setup = await createTestRenderer({ width: 24, height: 20, useThread: false })
+  const background = RGBA.fromHex("#101010")
+  const purple = RGBA.fromHex("#bb9af7")
+  const parser = new MockTreeSitterClient()
+  parser.setMockResult({ highlights: [] })
+  const markdown = new MarkdownRenderable(setup.renderer, {
+    content: "> First\n>\n> A longer quote that wraps across several lines.\n>\n> Last",
+    syntaxStyle: SyntaxStyle.fromStyles({ default: { fg: "#ffffff" }, conceal: { fg: purple }, "markup.quote": { fg: "#ffffff" } }),
+    bg: background,
+    treeSitterClient: parser,
+    streaming,
+    internalBlockMode: "top-level",
+    renderNode: (token, context) => token.type === "blockquote" ? solidQuoteBorder(context.defaultRender()) : undefined,
+  })
+  try {
+    setup.renderer.root.add(markdown)
+    await setup.flush()
+    parser.resolveAllHighlightOnce()
+    await setup.waitForFrame((frame) => frame.includes("First"), { maxPasses: 500 })
+    const frame = setup.captureSpans()
+    expect(markdown.height).toBeGreaterThan(4)
+    for (const line of frame.lines.slice(0, markdown.height)) {
+      expect(line.spans[0].text).toBe(" ")
+      expect(line.spans[0].width).toBe(1)
+      expect(line.spans[0].bg.toInts()).toEqual(purple.toInts())
+      expect(line.spans[1].bg.toInts()).not.toEqual(purple.toInts())
+    }
+    expect(setup.captureCharFrame().split("\n")[0].indexOf("First")).toBe(2)
+    expect(setup.captureCharFrame()).toContain("Last")
+    expect(setup.captureCharFrame()).not.toContain("│")
+    markdown.content = "> Updated\n>\n> Still continuous"
+    await setup.flush()
+    parser.resolveAllHighlightOnce()
+    await setup.waitForFrame((frame) => frame.includes("Updated"), { maxPasses: 500 })
+    expect(setup.captureCharFrame().split("\n")[0].indexOf("Updated")).toBe(2)
+    setup.resize(12, 20)
+    await setup.flush()
+    for (const line of setup.captureSpans().lines.slice(0, markdown.height)) {
+      expect(line.spans[0].bg.toInts()).toEqual(purple.toInts())
+    }
+  } finally {
+    setup.renderer.destroy()
+  }
+})
