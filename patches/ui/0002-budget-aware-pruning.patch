diff --git a/packages/opencode/test/session/compaction.test.ts b/packages/opencode/test/session/compaction.test.ts
index 896227901f..2a07119146 100644
--- a/packages/opencode/test/session/compaction.test.ts
+++ b/packages/opencode/test/session/compaction.test.ts
@@ -1975,3 +1975,12 @@ describe("SessionNs.getUsage", () => {
     expect(result.tokens.cache.write).toBe(300)
   })
 })
+
+
+test("local pruning thresholds scale down with context while preserving reclaim hysteresis", () => {
+  expect(SessionCompaction.pruneLimits(8192)).toEqual({ protect: 2048, minimum: 1024 })
+  expect(SessionCompaction.pruneLimits(32768)).toEqual({ protect: 8192, minimum: 4096 })
+  expect(SessionCompaction.pruneLimits(262144)).toEqual({ protect: 40000, minimum: 20000 })
+  for (const value of [0, -1, NaN, Infinity])
+    expect(SessionCompaction.pruneLimits(value)).toEqual({ protect: 40000, minimum: 20000 })
+})
