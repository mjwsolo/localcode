+        return false;
+    }
+    ggml_backend_dev_t dev = model.dev_layer(il);
+    if (!dev) {
+        return false;
+    }
+    for (const auto & [key, ok] : banded_dev_ok) {
+        if (key.first == swa && key.second == dev) {
+            return ok;
+        }
