/* LocalCode Textual TUI — Claude Code inspired styling */

Screen {
    layout: vertical;
    background: $surface;
    overflow: hidden;
}



/* ── Header bar (top) ── */

#header-bar {
    dock: top;
    height: 1;
    padding: 0 1;
    color: #5f87ff;
    background: $surface;
}

/* ── Chat log (scrollable center) ── */

#chat-log {
    height: 1fr;
    overflow-y: scroll;
    padding: 0 1;
    background: $surface;
    scrollbar-size: 1 1;
    scrollbar-color: $surface-lighten-1;
    scrollbar-background: $surface;
    scrollbar-corner-color: $surface;
}

/* ── Input area ── */

#chat-input {
    border: round #5f87ff;
    padding: 0 1 0 2;
    margin: 1 1 0 1;
    height: 3;
    background: $surface;
}

#chat-input:focus {
    border: round #5f87ff;
}

/* ── Status bar (bottom) ── */

#status-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
}

/* ── Queue indicator ── */

#queue-line {
    height: 1;
    padding: 0 1;
    color: $warning;
    display: none;
}

#queue-line.active {
    display: block;
}

/* ── Mode picker ── */

#mode-picker {
    align: center middle;
    padding: 2 4;
}

#mode-picker Static {
    text-align: center;
    margin-bottom: 1;
}

#mode-picker RadioSet {
    margin: 1 0;
}

#start-btn {
    margin-top: 1;
    align: center middle;
}

/* ── Approval modal (compact, bottom-aligned) ── */
