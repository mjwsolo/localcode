/* LocalCode Textual TUI — terminal-palette-driven styling.

   Background = `ansi_default`, the Textual color name that emits
   SGR 49 — the terminal's "default background" escape code. The user's
   own terminal profile decides what the colours actually look like
   (light/dark/solarized/dracula/etc.); LocalCode just defers.

   Paired with App.theme = "textual-ansi" set in tui/app.py — that
   theme defines `$background`, `$foreground`, `$surface` etc. all
   as ansi_default, so any widget that uses Textual variables instead
   of explicit hexes also inherits the terminal palette.

   `background-tint: transparent 0%` on every widget kills Textual's
   default ~5% foreground wash that was making the scrollable middle
   look lighter than the dock'd top/bottom regions. */

Screen {
    layout: vertical;
    background: ansi_default;
    background-tint: transparent 0%;
    overflow: hidden;
}



/* ── Brand bar (bottom, screens without a status row) ──
   Chat has its own bottom status row that includes the brand
   prefix; setup / mode-picker / model-picker have no status,
   so they yield a #brand-bar widget that docks here. */

#brand-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: ansi_default;
    background-tint: transparent 0%;
}

/* ── Chat log (scrollable center) ── */

#chat-log {
    height: 1fr;
    overflow-y: scroll;
    padding: 0 1;
    background: ansi_default;
    background-tint: transparent 0%;
    scrollbar-size-vertical: 1;
    scrollbar-color: #333333;
    scrollbar-color-hover: #555555;
    scrollbar-color-active: #666666;
    scrollbar-background: ansi_default;
    scrollbar-corner-color: ansi_default;
}

/* ── Input area ── */

/* Rounded thin border — the input is the one boxed element on screen,
   which makes it read as "type here" without any label. The border
   lives on #input-box (preview + input row together) so a long value
   that wraps to multiple lines grows inside the field instead of
   spilling above it into the chat area. */
#input-box {
    height: auto;
    border: round #444444;
    background: ansi_default;
    background-tint: transparent 0%;
}

/* height: auto so the row grows with the multi-line input instead of
   clipping it to a single line. The `›` prompt (height 1) top-aligns. */
#input-row {
    height: auto;
    border: none;
    background: ansi_default;
    background-tint: transparent 0%;
}

#input-prompt {
    width: 2;
    height: 1;
    padding: 0 0 0 1;
    color: #888888;
    background: ansi_default;
    background-tint: transparent 0%;
    content-align: left middle;
}

#chat-input {
    border: none;
    padding: 0;
    margin: 0;
    height: auto;
    width: 1fr;
    background: ansi_default;
    background-tint: transparent 0%;
}

#chat-input:focus {
    border: none;
    background: ansi_default;
    background-tint: transparent 0%;
}

/* Disabled state. Hit during the approval prompt: chat.py sets
   inp.disabled = True so the user can't type while the verdict
   buttons are showing. Textual's default disabled style paints a
   solid dark grey background that ignores ansi_default — read as
   "input is broken" by the user. Force the same terminal-palette
   background as the active state; Textual still dims the foreground
   text via its own disabled handling so the affordance is preserved. */
#chat-input:disabled {
    background: ansi_default;
    background-tint: transparent 0%;
}

/* Cursor cell — pairs with `_NoTintInput.render_line`, which
   substitutes the cursor cell's character with `▏` (U+258F) for a
   thin bar rather than a solid block. Background stays ansi_default
   (terminal palette); white foreground draws the bar glyph. */
#chat-input > .input--cursor {
    background: ansi_default;
    color: white;
    text-style: none;
}

Input:focus {
    background-tint: transparent 0%;
}

/* ── Status bar (bottom) ── */

#status-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: ansi_default;
    background-tint: transparent 0%;
    /* Left-aligned. When content > width the right end clips, but
       the version stays last in priority order — server / context
       / mode / model are all more important to keep visible. */
    text-align: left;
}

/* ── Queue indicator ── */

#queue-line {
    height: 1;
    padding: 0 1;
    color: $warning;
    background: ansi_default;
    background-tint: transparent 0%;
    display: none;
}

#queue-line.active {
    display: block;
}

/* ── Mode picker ── */

#mode-picker {
    align: center middle;
    padding: 2 4;
}

#mode-picker Static {
    text-align: center;
    margin-bottom: 1;
}

#mode-picker RadioSet {
    margin: 1 0;
}

#start-btn {
    margin-top: 1;
    align: center middle;
}

/* ── Approval modal (compact, bottom-aligned) ── */
