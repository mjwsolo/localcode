---
/**
 * Unified-memory model chooser.
 *
 * Nothing here is hand-written: src/data/models.json is generated from
 * localcode's own catalogue by scripts/gen-models.py. For each memory tier it
 * lists EVERY model in the catalogue that fits the budget that
 * `localcode.models_catalog.recommend()` uses (the GPU memory macOS allows).
 * It marks no recommendation: the site cannot know the reader's Mac.
 *
 * Regenerate after a catalogue change:
 *   ~/.local/share/uv/tools/localcode/bin/python docs/scripts/gen-models.py
 */
import tiers from '../data/models.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** Model-family marks, self-hosted in public/logos (no third-party CDN call).
 *  The `logo` key on each row is emitted by scripts/gen-models.py from the
 *  catalogue's own family field, so a new Gemma or Qwen variant picks up the
 *  right mark with no edit here. */
const logoSrc = (logo: string | null) => (logo ? `${base}/logos/${logo}.svg` : null);
---

<div class="lc-mem">
  <div class="lc-mem__tabs" role="tablist" aria-label="Unified memory">
    {tiers.map((t, i) => (
      <button
        type="button"
        role="tab"
        class="lc-mem__tab"
        id={`mem-tab-${t.ram}`}
        aria-controls={`mem-panel-${t.ram}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        {t.label}
      </button>
    ))}
  </div>

  {tiers.map((t, i) => (
    <div
      class="lc-mem__panel"
      role="tabpanel"
      id={`mem-panel-${t.ram}`}
      aria-labelledby={`mem-tab-${t.ram}`}
      hidden={i !== 0}
    >
      <p class="lc-mem__count">
        <strong>{t.models.length}</strong>
        {t.models.length === 1 ? ' model fits' : ' models fit'} in {t.budget} GB
        <span class="lc-mem__count-sub">: the GPU memory macOS allows on a {t.ram} GB Mac ({Math.round((t.budget / t.ram) * 100)}%), which also holds the context</span>
      </p>

      <div class="lc-mem__head" aria-hidden="true">
        <span></span>
        <span>Model</span>
        <span>Parameters</span>
        <span>Active</span>
        <span>Type</span>
        <span>Quant</span>
        <span class="lc-mdl__size">Weights</span>
      </div>

      <ul class="lc-mem__list">
        {t.models.map((mdl) => {
          const src = logoSrc(mdl.logo);
          return (
            <li class="lc-mdl">
              <span class="lc-mdl__mark" aria-hidden="true">
                {src ? <img src={src} alt="" width="16" height="16" loading="lazy" /> : <span>{mdl.maker.slice(0, 1)}</span>}
              </span>

              <span class="lc-mdl__id">
                <span class="lc-mdl__name">
                  {mdl.base}
                </span>
                {mdl.detail && <span class="lc-mdl__detail">{mdl.detail}</span>}
              </span>

              <span class="lc-mdl__cell"><span class="lc-mdl__k">Parameters</span>{mdl.total ?? '—'}</span>
              <span class="lc-mdl__cell"><span class="lc-mdl__k">Active</span>{mdl.active ?? '—'}</span>
              <span class="lc-mdl__cell"><span class="lc-mdl__k">Type</span>{mdl.kind}</span>
              <span class="lc-mdl__cell"><span class="lc-mdl__k">Quant</span>{mdl.quant ?? '—'}</span>

              <span class="lc-mdl__size"><span class="lc-mdl__k">Weights</span>{mdl.size} GB</span>
            </li>
          );
        })}
      </ul>
    </div>
  ))}

  <p class="lc-mem__rule">
    These are the models that fit each memory size. You choose: the model
    picker in localcode reads your Mac's actual memory and marks what fits,
    and <code>/models</code> switches at any time.
  </p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.lc-mem')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.lc-mem__tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.lc-mem__panel')];
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        const next = (i + delta + tabs.length) % tabs.length;
        select(next);
        tabs[next].focus();
      });
    });
  }
</script>
