---
/**
 * The product demo on the landing page: install, model picker, and three real sessions
 * (a bug fix, a code walkthrough, a new app), with narration. Plays on request only.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/demo/localcode_demo.mp4`;
const poster = `${base}/demo/localcode_demo.jpg`;
---

<figure class="lc-demo">
  <div class="lc-demo__frame">
    <video
      src={src}
      poster={poster}
      width="1280"
      height="720"
      controls
      playsinline
      preload="none"
      aria-label="localcode demo: installing, choosing a model, then fixing a bug, explaining code and building an app"
    ></video>
  </div>
</figure>

<style>
  .lc-demo {
    margin: 0;
  }

  .lc-demo__frame {
    border: 1px solid var(--lc-line, #2a2f34);
    border-radius: calc(var(--lc-radius, 4px) * 2);
    overflow: hidden;
    background: var(--lc-page-2, #171a1d);
    line-height: 0;
  }

  .lc-demo__frame video {
    width: 100%;
    height: auto;
    display: block;
  }

</style>
