---
/**
 * The site navigation bar — ONE component, used by both the landing page and
 * the docs (via the Starlight `Header` override). Previously these were two
 * lookalike implementations that drifted apart on every edit; there is now a
 * single source of truth.
 *
 * Styles live in src/styles/nav.css, which is loaded by the landing page and
 * registered in astro.config.mjs → customCss so the docs get it too.
 */
import HouseMark from './HouseMark.astro';

interface Props {
  /** Docs pages pass their Starlight search UI through to sit in the middle. */
  search?: boolean;
  /** Landing page points at the docs; the docs point back home. */
  linkLabel?: string;
  linkHref?: string;
}
const { search = false, linkLabel = 'Docs', linkHref = 'start-here/first-change' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<header class="lc-nav">
  <div class="lc-nav__inner">
    <a class="lc-lockup" href={`${base}/`} aria-label="localcode home">
      <HouseMark size={28} />
      <span>localcode</span>
    </a>

    {search && (
      <div class="lc-nav__search">
        <slot name="search" />
      </div>
    )}

    <nav class="lc-nav__links" aria-label="Primary">
      <a href={linkHref === '/' ? `${base}/` : href(linkHref)}>{linkLabel}</a>
    </nav>

    <div class="lc-nav__tools">
      <a
        class="lc-ghlink"
        href="https://github.com/mjwsolo/localcode"
        rel="me"
        aria-label="localcode on GitHub"
      >
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
      </a>

      <span class="lc-nav__divider" aria-hidden="true"></span>

      <button type="button" id="lc-theme" class="lc-theme" aria-label="Switch theme" title="Switch theme">
        <span class="lc-theme__icon" aria-hidden="true">
          <svg class="is-dark" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
          </svg>
          <svg class="is-light" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path
              d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-14a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V4a1 1 0 0 1 1-1Zm0 15.5a1 1 0 0 1 1 1V21a1 1 0 1 1-2 0v-1.5a1 1 0 0 1 1-1ZM3 12a1 1 0 0 1 1-1h1.5a1 1 0 1 1 0 2H4a1 1 0 0 1-1-1Zm15.5 0a1 1 0 0 1 1-1H21a1 1 0 1 1 0 2h-1.5a1 1 0 0 1-1-1ZM5.64 5.64a1 1 0 0 1 1.42 0l1.06 1.06a1 1 0 0 1-1.42 1.42L5.64 7.06a1 1 0 0 1 0-1.42Zm10.24 10.24a1 1 0 0 1 1.42 0l1.06 1.06a1 1 0 0 1-1.42 1.42l-1.06-1.06a1 1 0 0 1 0-1.42Zm2.48-10.24a1 1 0 0 1 0 1.42l-1.06 1.06a1 1 0 1 1-1.42-1.42l1.06-1.06a1 1 0 0 1 1.42 0ZM8.12 15.88a1 1 0 0 1 0 1.42L7.06 18.36a1 1 0 0 1-1.42-1.42l1.06-1.06a1 1 0 0 1 1.42 0Z"
            />
          </svg>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  // Two-state theme toggle sharing Starlight's `starlight-theme` storage key,
  // so the choice survives moving between the landing page and the docs.
  const toggle = document.getElementById('lc-theme');

  const apply = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    toggle?.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  };

  let stored: string | null = null;
  try {
    stored = localStorage.getItem('starlight-theme');
  } catch {
    /* storage blocked — fall back to the default below */
  }
  apply(stored === 'light' ? 'light' : 'dark');

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    apply(next);
    try {
      localStorage.setItem('starlight-theme', next);
    } catch {
      /* storage blocked — the choice still holds for this page view */
    }
  });
</script>
