---
/**
 * Terminal treatment: read → edit → failed check → recovery → verified.
 *
 * IMPORTANT — this is an ILLUSTRATIVE DESIGN PREVIEW, not a recorded run.
 * No timings, durations, token counts, or throughput figures appear here,
 * because none of them would be measured. The tool names (`read_file`,
 * `edit_file`, `bash`) are real localcode tools and `pytest -q` is a real
 * command the model can run; the output text is written for this page.
 *
 * The showcased prompt starts with "change" deliberately: `infer_goal_state`
 * classifies it as `edit_existing`, which is one of the two goal types the
 * evidence gate covers. A phrasing like "make X accept Y" classifies as
 * `general_task` and would NOT be gated — so it would misrepresent the flow
 * this page is describing.
 */
interface Row {
  cls: string;
  sigil?: string;
  glyph?: string;
  tool?: string;
  arg?: string;
  text?: string;
}

const NEWLINE = String.fromCharCode(10);
const BLANK: Row = { cls: 'l' };

const rows: Row[] = [
  { cls: 'l l--prompt', sigil: '>', text: 'change parse_duration so it accepts "1h30m"' },
  BLANK,
  { cls: 'l l--ok', glyph: '\u2022', tool: 'read_file', arg: '(src/timeutil.py)' },
  { cls: 'l l--note', text: '  found parse_duration \u2014 handles "90m" and "2h", not compound units' },
  { cls: 'l l--ok', glyph: '\u2022', tool: 'edit_file', arg: '(src/timeutil.py)' },
  BLANK,
  { cls: 'l l--fail', glyph: '\u00d7', tool: 'bash', arg: '(pytest -q)' },
  { cls: 'l l--failtext', text: '  1 failed \u2014 test_parse_duration_rejects_garbage' },
  { cls: 'l l--note', text: '  the new regex made every unit optional, so "" now parses' },
  BLANK,
  { cls: 'l l--ok', glyph: '\u2022', tool: 'edit_file', arg: '(src/timeutil.py)' },
  { cls: 'l l--note', text: '  require at least one unit; keep the compound branch' },
  { cls: 'l l--ok', glyph: '\u2022', tool: 'bash', arg: '(pytest -q)' },
  { cls: 'l l--verifytext', text: '  \u2713 48 passed' },
  BLANK,
  { cls: 'l l--note', text: '  changed 1 file \u00b7 closed on a check that passed' },
];

// The trailing newline is baked into each row here rather than emitted as a
// JSX expression, which keeps the <pre> body free of escape sequences.
const lines = rows.map((row) => ({
  cls: row.cls,
  sigil: row.sigil ? row.sigil + ' ' : '',
  glyph: row.glyph ? row.glyph + ' ' : '',
  tool: row.tool ?? '',
  arg: row.arg ?? '',
  tail: (row.text ?? '') + NEWLINE,
}));
---

<figure class="lc-term lc-on-dark">
  <figcaption class="lc-term__bar">
    <span class="lc-term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="lc-term__title">localcode — ~/work/timeutil</span>
    <span class="lc-term__tag">design preview</span>
  </figcaption>

  <pre class="lc-term__body"><code>{lines.map((line) => (<span class={line.cls}><span class="sigil">{line.sigil}</span><span class="glyph">{line.glyph}</span><span class="tool">{line.tool}</span><span class="arg">{line.arg}</span>{line.tail}</span>))}</code></pre>

  <p class="lc-term__disclaimer">
