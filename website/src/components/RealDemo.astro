---
/**
 * A REAL recorded localcode turn — not a design preview.
 *
 * Frames are captured from the running localcode interface while the
 * agent works against a local llama-server, then assembled with ffmpeg. The repository's tests
 * genuinely pass at the end of the take; nothing here is authored.
 *
 * Regenerate: website/demo-tapes/record.sh
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/demo/first-change.gif?v=ad5980ad`;
const still = `${base}/demo/first-change-final.png?v=a4688fab`;
---

<figure class="lc-demo">
  <div class="lc-demo__frame">
    <img
      src={src}
      alt="A real localcode turn: it reads the stub and test, edits the file, runs pytest -q, and reports 1 passed"
      width="1224"
      height="748"
      loading="lazy"
      decoding="async"
      style={`background-image:url(${still});background-size:cover`}
    />
  </div>
</figure>

<style>
  .lc-demo {
    margin: 0;
  }

  .lc-demo__frame {
    border: 1px solid var(--lc-line, #2a2f34);
    border-radius: calc(var(--lc-radius, 4px) * 2);
    overflow: hidden;
    background: var(--lc-page-2, #171a1d);
    line-height: 0;
  }

  .lc-demo__frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* caption removed — the frame speaks for itself */

  @media (prefers-reduced-motion: reduce) {
    .lc-demo__frame img {
      content: none;
    }
  }
</style>
