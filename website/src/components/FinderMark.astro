---
/**
 * Finder Mark — two concentric orthogonal square rings with an offset solid
 * core. Inline (not <img>) so the rings inherit currentColor and the core
 * picks up --lc-mark-core from the active theme.
 *
 * Geometry is hand-authored on a 32-unit grid and is intentionally identical
 * to src/assets/brand/finder-mark.svg.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-width="2.5">
    <rect x="3" y="3" width="26" height="26" />
    <rect x="9.5" y="9.5" width="13" height="13" />
  </g>
  <rect x="14.5" y="14.5" width="6" height="6" fill="var(--lc-mark-core, #2457e6)" />
</svg>
