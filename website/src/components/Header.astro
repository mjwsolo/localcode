---
/**
 * Starlight `Header` override — replaces Starlight's own header with the
 * landing page's nav, so both surfaces render the SAME component rather than
 * two implementations that have to be kept in sync by hand.
 *
 * Starlight's search UI is passed through into the nav's middle slot, and the
 * mobile sidebar toggle is kept: without it there is no way to reach the
 * sidebar on a phone.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import SiteNav from './SiteNav.astro';
// The docs version switcher (starlight-versions). The plugin normally mounts it
// through Starlight's ThemeSelect slot, which this site overrides with nothing,
// so it is rendered here next to search instead.
import VersionSelect from 'starlight-versions/components/VersionSelect.astro';
---

<SiteNav search linkLabel="Home" linkHref="/">
  <div slot="search" class="lc-docs-tools">
    <Search />
    <VersionSelect />
  </div>
</SiteNav>

<style is:global>
  .lc-docs-tools { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
  .lc-docs-tools > :first-child { flex: 1 1 auto; min-width: 0; }
  .lc-docs-tools starlight-version-select { flex: 0 0 auto; }
</style>

<div class="lc-mobile-menu md:sl-hidden">
  <MobileMenuToggle />
</div>
