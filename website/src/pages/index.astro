---
import '@fontsource-variable/instrument-sans';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/tokens.css';
// Shared with the docs via astro.config.mjs → customCss. Must be imported
// here too: the landing page is not a Starlight route, so it does not pick up
// that list.
import '../styles/nav.css';
import '../styles/landing.css';

import HouseMark from '../components/HouseMark.astro';
import SiteNav from '../components/SiteNav.astro';
import CopyCommand from '../components/CopyCommand.astro';
import RealDemo from '../components/RealDemo.astro';
import MemoryChooser from '../components/MemoryChooser.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const title = 'localcode: Agentic coding. Local models. On your Mac.';
const description =
  'An open-source coding agent that runs local models on Apple Silicon. No API key. No costs.';

/** Hero badges. Rendered as real elements, not shields.io images: they stay
 *  crisp on retina, need no third-party request, and follow the theme. */
const badges = [
  { k: 'pypi', v: 'v0.3.64', href: 'https://pypi.org/project/localcode/' },
  { k: 'license', v: 'Apache 2.0', href: 'https://github.com/mjwsolo/localcode/blob/main/LICENSE' },
  { k: 'python', v: '3.10+' },
  { k: 'platform', v: 'Apple Silicon' },
  { k: 'memory', v: '16 GB+' },
];

const proof = [
  {
    title: 'A suite of local models',
    body: `Choose from Qwen, Gemma, Cohere, and Meta families. The suite includes
      dense and MoE models from 12B to 35B, with several quants for each.
      localcode checks your Mac's unified memory, shows every model that fits,
      and recommends the most capable one. Switch at any time with /model.`,
    link: { label: 'See what your Mac runs', href: href('start-here/choose-a-model') },
  },
  {
    title: 'The server sets itself up',
    body: `localcode
      downloads the weights and starts llama-server on 127.0.0.1. It sets the
      context and KV cache sizes for your machine. It shuts down the server when
      you finish. You do not need to configure anything.`,
    link: { label: 'How it runs', href: href('concepts/architecture') },
  },
  {
    title: 'A system designed for local models',
    body: `localcode is built specifically for local models. The agent loop,
      prompts, and model server are tuned to get the best performance out of
      small models on your Mac, with no API key, account, or bill.`,
    link: { label: 'What we tuned for local models', href: href('concepts/architecture#built-specifically-for-small-models') },
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1113" />
    <link rel="icon" href={href('favicon-house.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Open Graph needs an absolute URL — Astro.site is the deployed origin. */}
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL(`${base}/social-preview.svg`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(`${base}/social-preview.svg`, Astro.site).href} />
    <script is:inline>
      // Match Starlight's theme storage so the landing page and the docs
      // agree on light/dark across navigation.
      (() => {
        const stored = (() => {
          try {
            return localStorage.getItem('starlight-theme');
          } catch {
            return null;
          }
        })();
        // Dark is the default. Only an explicit choice makes it light — the
        // OS preference does not decide, because the brand is dark.
        const theme = stored === 'light' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="lc-skip" href="#main">Skip to content</a>

    <SiteNav />

    <main id="main">
      <!-- Hero -->
      <section class="lc-hero">
        <div class="lc-hero__inner">
          <div class="lc-hero__copy">
            <h1 class="lc-h1">
              Agentic coding.<br />Local models.<br /><span class="lc-h1__accent"
                >On your Mac.</span
              >
            </h1>
            <p class="lc-sub">{description}</p>

            <ul class="lc-badges">
              {badges.map((b) => {
                const inner = (
                  <>
                    <span class="lc-badge__k">{b.k}</span>
                    <span class="lc-badge__v">{b.v}</span>
                  </>
                );
                return (
                  <li class="lc-badge">
                    {b.href ? <a href={b.href}>{inner}</a> : inner}
                  </li>
                );
              })}
            </ul>
            <CopyCommand command="pip install -U localcode" label="install" />
          </div>

          <div class="lc-hero__proof">
            <RealDemo />
            <p class="lc-hero__overline">Pick a model. Start coding.</p>
          </div>
        </div>
      </section>

      <!-- Proof points -->
      <section class="lc-section">
        <div class="lc-section__inner">
          <h2 class="lc-h2">Pick a model. Everything else happens automatically.</h2>
          <p class="lc-lede">
            localcode combines the model server and coding agent in one command.
            It checks what your Mac can run. It starts the server for you. Then it
            uses a loop designed for local weights to read and edit files and run
            your repo's own checks.
          </p>
          <div class="lc-grid">
            {proof.map((card, i) => (
              <article class="lc-card">
                <span class="lc-card__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="lc-card__title">{card.title}</h3>
                <p class="lc-card__body">{card.body}</p>
                <a class="lc-card__link" href={card.link.href}>{card.link.label} →</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Three steps -->
      <section class="lc-section">
        <div class="lc-section__inner">
          <h2 class="lc-h2">Three steps</h2>
          <p class="lc-lede">
            Install localcode. Open a repo. Pick a model. Ask it to do one
            thing.
          </p>

          <ol class="lc-steps">
            <li class="lc-step">
              <h3 class="lc-step__h"><span>1</span> Install and open your repo</h3>
              <pre class="lc-step__pre"><code>pip install -U localcode
cd ~/work/some-project
localcode</code></pre>
            </li>

            <li class="lc-step">
              <h3 class="lc-step__h"><span>2</span> Choose a model</h3>
              <p class="lc-step__p">
                The star shows the largest model your Mac can run comfortably.
              </p>
              <img
                class="lc-step__img"
                src={`${base}/demo/step-2-choose-model.gif?v=a0c3cc9d`}
                alt="The localcode model picker: arrowing through seven models and selecting one"
                width="866" height="491" loading="lazy" decoding="async"
              />
            </li>

            <li class="lc-step">
              <h3 class="lc-step__h"><span>3</span> Start building</h3>
              <p class="lc-step__p">
                Name the file. Then name the check that proves the change worked.
              </p>
              <img
                class="lc-step__img"
                src={`${base}/demo/step-3-ask.gif?v=0523fe0c`}
                alt="Typing a goal into the localcode chat screen and pressing enter"
                width="866" height="491" loading="lazy" decoding="async"
              />
            </li>

          </ol>

          <a class="lc-btn lc-btn--primary" href={href('start-here/first-change')}>
            Read more
          </a>
        </div>
      </section>

      <!-- Memory chooser -->
      <section class="lc-section lc-section--alt">
        <div class="lc-section__inner">
          <h2 class="lc-h2">Every model your Mac can run</h2>
          <p class="lc-lede">
            Unified memory sets the limit. Pick your Mac to see the full list of
            models that fit. localcode recommends the most capable one and marks
            it with a star. You choose, and you can switch to any other model on
            the list.
          </p>
          <MemoryChooser />
        </div>
      </section>

      <!-- Closing CTA -->
      <section class="lc-final">
        <div class="lc-section__inner">
          <HouseMark size={44} />
          <h2 class="lc-h2">Start building</h2>
          <p class="lc-lede">
            Point localcode at a repo you already have. Ask for one small edit.
            Then see how it responds when the checks come back red.
          </p>
          <CopyCommand command="pip install -U localcode" label="install" />
          <div class="lc-cta">
            <a class="lc-btn lc-btn--primary" href={href('start-here/first-change')}>
              Start building
            </a>
            <a class="lc-btn" href={href('start-here/choose-a-model')}>Choose a model</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="lc-foot">
      <div class="lc-section__inner">
        <a class="lc-lockup lc-lockup--sm" href={href('/')}>
          <HouseMark size={20} />
          <span>localcode</span>
        </a>
        <p>
          Apache-2.0 · <a href="https://github.com/mjwsolo/localcode">github.com/mjwsolo/localcode</a>
        </p>
        <p class="lc-fine">
          Alpha software, under active development.
        </p>
      </div>
    </footer>

    <script>
      // Icon-only theme toggle. Writes the same `starlight-theme` key Starlight
      // uses, so a choice made here survives the jump into the docs.
      const toggle = document.getElementById('lc-theme');

      const apply = (theme: string) => {
        document.documentElement.dataset.theme = theme;
        toggle?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
      };

      let stored: string | null = null;
      try {
        stored = localStorage.getItem('starlight-theme');
      } catch {
        /* storage blocked — fall back to the default below */
      }
      apply(stored === 'light' ? 'light' : 'dark');

      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        apply(next);
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          /* storage blocked — the choice still holds for this page view */
        }
      });
    </script>
  </body>
</html>
