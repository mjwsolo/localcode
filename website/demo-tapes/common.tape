# Shared look for every recording (sourced by the tapes).
Set Shell "bash"
Set FontSize 15
Set FontFamily "Menlo"
Set Width 1180
Set Height 700
Set Padding 12
Set Theme { "name": "localcode", "black": "#0b0e11", "red": "#ff6b6b", "green": "#7ee787", "yellow": "#f2cc60", "blue": "#5f87ff", "magenta": "#c88afa", "cyan": "#79c0ff", "white": "#c9d1d9", "brightBlack": "#484f58", "brightRed": "#ff7b72", "brightGreen": "#7ee787", "brightYellow": "#f2cc60", "brightBlue": "#79c0ff", "brightMagenta": "#d2a8ff", "brightCyan": "#a5d6ff", "brightWhite": "#f0f6fc", "background": "#0b0e11", "foreground": "#c9d1d9", "cursor": "#c9d1d9", "selection": "#264f78" }
Set TypingSpeed 40ms
Set Framerate 12
